<a class="back-link" href="<%= ui.h(ui.path("/")) %>">← Evaluation history</a>
<div class="page-heading"><div><p class="eyebrow">Run detail · <%= ui.h(run["agent"]) %></p><h1><%= ui.h(run["suite"]) %></h1><p class="lead"><time datetime="<%= ui.h(run["started_at"]) %>"><%= ui.h(ui.time(run["started_at"])) %></time></p></div><a class="button primary" href="<%= ui.h(ui.report_path(run["id"])) %>" download>Download JSON report</a></div>
<% summary = run["summary"] %>
<section class="stats-grid" aria-label="Run summary">
  <article class="stat-card"><span class="stat-label">Quality score</span><strong><%= ui.score(summary["score"]) %></strong><span class="stat-caption">normalized across metrics</span></article>
  <article class="stat-card"><span class="stat-label">Case pass rate</span><strong><%= ui.percent(summary["pass_rate"]) %></strong><span class="stat-caption"><%= summary["passed"] %> of <%= summary.fetch("evaluated_cases", summary["cases"] - summary.fetch("not_evaluated", 0)) %> evaluated cases passed<% if summary.fetch("not_evaluated", 0).positive? %> · <%= summary["not_evaluated"] %> not evaluated<% end %></span></article>
  <article class="stat-card"><span class="stat-label">Failures / errors</span><strong class="<%= summary["failed"].positive? || summary["errors"].positive? ? "danger-text" : "teal-text" %>"><%= summary["failed"] %> / <%= summary["errors"] %></strong><span class="stat-caption">failed cases / errored cases</span></article>
  <article class="stat-card"><span class="stat-label">Run duration</span><strong><%= ui.duration(summary["duration_ms"]) %></strong><span class="stat-caption"><%= summary["input_tokens"] %> in · <%= summary["output_tokens"] %> out tokens · <%= ui.cost(summary["cost"]) %></span></article>
</section>
<section class="panel comparison-panel" aria-labelledby="comparison-heading"><div class="section-heading"><div><p class="eyebrow">Regression tracking</p><h2 id="comparison-heading"><%= summary["score"].nil? ? "No quality metrics calculated." : comparison ? (comparison["regressed"] ? "Quality needs attention." : comparison["improvements"].empty? ? "Holding the baseline." : "Moving in the right direction.") : "Your baseline starts here." %></h2></div><% if comparison %><span class="badge <%= summary["score"].nil? ? "neutral" : comparison["regressed"] ? "failed" : "passed" %>"><%= summary["score"].nil? ? "Not evaluated" : comparison["regressed"] ? "Regression detected" : "No regression" %></span><% end %></div>
<% if comparison %>
  <p class="section-description">Compared with <a href="<%= ui.h(ui.run_path(comparison["baseline_id"])) %>">the previous matching run</a> using the same suite, agent, and dataset fingerprint. Score tolerance: 0.</p>
  <div class="comparison-deltas"><div><span>Quality score change</span><strong class="<%= comparison["score_delta"]&.negative? ? "danger-text" : "teal-text" %>"><%= ui.delta(comparison["score_delta"]) %></strong></div><div><span>Pass rate change</span><strong class="<%= comparison["pass_rate_delta"]&.negative? ? "danger-text" : "teal-text" %>"><%= ui.delta(comparison["pass_rate_delta"], percentage: true) %></strong></div></div>
  <% [["Regressions", comparison["regressions"], "failed"], ["Improvements", comparison["improvements"], "passed"]].each do |heading, items, type| %><% unless items.empty? %><h3><%= heading %> <span class="badge <%= type %>"><%= items.length %></span></h3><ul class="evidence-list"><% items.each do |item| %><li><div><strong><%= ui.h(item["case_name"]) %></strong><% if item["evaluator"] %><span class="muted"> · <%= ui.h(item["evaluator"]) %></span><% end %></div><p><%= ui.h(item["reason"]) %></p><span class="mono muted">Score <%= ui.score(item["baseline_score"]) %> → <%= ui.score(item["current_score"]) %><%= " (#{ui.delta(item["delta"])})" unless item["delta"].nil? %></span></li><% end %></ul><% end %><% end %>
<% else %><p class="section-description">There is no earlier run with the same suite, agent, and dataset fingerprint. Future matching runs will compare against this evidence; different datasets are never treated as regressions.</p><% end %></section>
<section class="panel dimension-summary" aria-labelledby="dimensions-heading">
  <h2 id="dimensions-heading">Dimension quality</h2>
  <p class="section-description">Mean scores include scored assessments only; errors are reported separately, never as scored zero.</p>
  <% dimensions = run["cases"].flat_map { |item| item["metrics"] }.group_by { |evaluation| evaluation["name"] } %>
  <% if dimensions.empty? %><p class="muted">No metric assessments were recorded.</p><% else %>
  <div class="table-scroll" tabindex="0" role="region" aria-label="Dimension quality table"><table><caption>Quality by evaluator</caption><thead><tr><th scope="col">Dimension</th><th scope="col">Mean score</th><th scope="col">Scored</th><th scope="col">Passed</th><th scope="col">Errors</th></tr></thead><tbody>
  <% dimensions.each do |name, assessments| %><% scored = assessments.reject { |evaluation| evaluation["error"] || evaluation["score"].nil? } %>
    <tr><th scope="row"><%= ui.h(name) %></th><td class="mono"><%= ui.score(scored.empty? ? nil : scored.sum { |evaluation| evaluation["score"] } / scored.length.to_f) %></td><td><%= scored.length %></td><td><%= scored.count { |evaluation| evaluation["passed"] } %></td><td><%= assessments.count { |evaluation| evaluation["error"] } %></td></tr>
  <% end %></tbody></table></div><% end %>
</section>
<section class="case-section" aria-labelledby="cases-heading"><div class="section-heading"><div><p class="eyebrow">Inspect the evidence</p><h2 id="cases-heading">Case results</h2></div><span class="muted"><%= run["cases"].length %> cases</span></div>
<% if run["cases"].empty? %><p class="panel empty-state">This run contains no case results.</p><% end %>
<% run["cases"].each_with_index do |item, index| %>
<article class="panel case-card" aria-labelledby="case-<%= index %>"><header class="case-header"><div><span class="eyebrow">Case <%= index + 1 %> · <%= ui.h(item["id"]) %></span><h3 id="case-<%= index %>"><%= ui.h(item["name"]) %></h3></div><span class="badge <%= %w[passed failed error].include?(item["status"]) ? item["status"] : "neutral" %>"><%= ui.h(item["status"].tr("_", " ").capitalize) %></span></header>
  <div class="case-telemetry"><span><%= ui.duration(item["duration_ms"]) %></span><span><%= item["input_tokens"].nil? ? "—" : item["input_tokens"] %> input tokens</span><span><%= item["output_tokens"].nil? ? "—" : item["output_tokens"] %> output tokens</span><span><%= ui.cost(item["cost"]) %></span></div>
  <% if item["error"] %><div class="error-alert" role="note"><strong><%= ui.h(item["error"]["class"]) %></strong><pre><%= ui.h(item["error"]["message"]) %></pre></div><% end %>
  <div class="payload-grid"><section><h4>Question</h4><pre class="payload"><%= ui.h(ui.pretty(item["question"])) %></pre></section><section><h4>Expected answer</h4><pre class="payload"><%= ui.h(ui.pretty(item["expected_answer"])) %></pre></section><section class="output-payload"><h4>Agent output</h4><pre class="payload"><%= ui.h(ui.pretty(item["output"])) %></pre></section></div>
  <details class="metadata-details"><summary>Minimum passing scores</summary><pre class="payload"><%= ui.h(ui.pretty(item["minimum_scores"])) %></pre></details>
  <% uncalculated = item.fetch("minimum_scores", {}).keys - item["metrics"].map { |metric| metric["name"] } %>
  <% unless uncalculated.empty? %><p class="muted">Not calculated: <%= ui.h(uncalculated.join(", ")) %></p><% end %>
  <div class="table-scroll evaluation-table" tabindex="0" role="region" aria-label="Evaluations for <%= ui.h(item["name"]) %>">
    <table><caption>Metric assessments</caption><thead><tr><th scope="col">Evaluator</th><th scope="col">Score</th><th scope="col">Threshold</th><th scope="col">Result</th><th scope="col">Evidence</th></tr></thead><tbody>
    <% item["metrics"].each do |evaluation| %>
      <tr><td><strong><%= ui.h(evaluation["name"]) %></strong></td><td class="mono"><%= ui.score(evaluation["error"] ? nil : evaluation["score"]) %></td><td class="mono"><%= ui.score(evaluation["threshold"]) %></td><td><span class="badge <%= evaluation["error"] ? "error" : evaluation["passed"] ? "passed" : "failed" %>"><%= evaluation["error"] ? "Error" : evaluation["passed"] ? "Passed" : "Failed" %></span></td>
        <td class="evaluation-reason"><% if evaluation["error"] %><strong class="danger-text"><%= ui.h(evaluation["error"]["class"]) %></strong><br><%= ui.h(evaluation["error"]["message"]) %><% elsif evaluation["reason"] %><%= ui.h(evaluation["reason"]) %><% else %><span class="muted">No reason provided</span><% end %></td></tr>
    <% end %>
    <% if item["metrics"].empty? %><tr><td colspan="5" class="muted">No metrics ran for this case.</td></tr><% end %>
    </tbody></table>
  </div>
  <div class="payload-grid">
  <% [["Expected actions", "expected_actions", "Unavailable — expected actions not specified", "No actions expected ([])"], ["Observed actions", "actions", "Unavailable — action instrumentation missing", "Observed no actions ([])"]].each do |label, key, missing, empty| %>
    <section><h4><%= label %></h4><% if item[key].nil? %><p class="muted"><%= missing %></p><% elsif item[key].empty? %><p class="muted"><%= empty %></p><% else %><p class="muted small">Ordered trace: group, name, and arguments.</p><ol class="evidence-list"><% item[key].each do |action| %><li><pre class="payload"><%= ui.h(ui.pretty(action)) %></pre></li><% end %></ol><% end %></section>
  <% end %>
  </div>
  <details class="metadata-details"><summary>Response metadata</summary><pre class="payload"><%= ui.h(item["response_metadata"].nil? ? "Unavailable — response metadata not reported" : ui.pretty(item["response_metadata"])) %></pre></details>
  <% unless item["metadata"].empty? %><details class="metadata-details"><summary>Case metadata</summary><pre class="payload"><%= ui.h(ui.pretty(item["metadata"])) %></pre></details><% end %>
</article><% end %>
</section>
<section class="panel run-metadata"><h2>Run provenance</h2><dl><dt>Run ID</dt><dd class="mono"><%= ui.h(run["id"]) %></dd><dt>Agent</dt><dd><%= ui.h(run["agent"]) %></dd><dt>Dataset fingerprint</dt><dd class="mono"><%= ui.h(run["suite_digest"]) %></dd><dt>Finished</dt><dd><%= ui.h(ui.time(run["finished_at"])) %></dd><dt>Status</dt><dd><%= ui.h(run["status"]) %></dd></dl><% unless run["metadata"].empty? %><details class="metadata-details"><summary>Run metadata</summary><pre class="payload"><%= ui.h(ui.pretty(run["metadata"])) %></pre></details><% end %><p class="muted small">Telemetry is reported by the agent; aggregate token and cost totals include only reported values. A dash indicates an unreported case value.</p></section>
