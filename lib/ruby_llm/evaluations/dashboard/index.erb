<div class="page-heading"><div><p class="eyebrow">Evaluation workspace</p><h1>Know how your agent performs.</h1><p class="lead">Track quality over time, inspect the evidence, and catch regressions before they ship.</p></div><span class="workspace-status"><span aria-hidden="true"></span> Local history</span></div>
<section class="panel filter-panel" aria-label="Filter evaluation history">
  <form action="<%= ui.h(ui.path("/")) %>" method="get" class="filter-form">
    <div class="field"><label for="suite">Evaluation suite</label><select id="suite" name="suite"><option value="">All suites</option><% (catalog.map { |run| run["suite"] } + [query["suite"]]).compact.uniq.sort.each do |suite| %><option value="<%= ui.h(suite) %>"<%= " selected" if query["suite"] == suite %>><%= ui.h(suite) %></option><% end %></select></div>
    <div class="field"><label for="agent">Agent</label><select id="agent" name="agent"><option value="">All agents</option><% (catalog.map { |run| run["agent"] } + [query["agent"]]).compact.uniq.sort.each do |agent| %><option value="<%= ui.h(agent) %>"<%= " selected" if query["agent"] == agent %>><%= ui.h(agent) %></option><% end %></select></div>
    <% if query["limit"] %><input type="hidden" name="limit" value="<%= ui.h(query["limit"]) %>"><% end %>
    <button class="button primary" type="submit">Apply filters</button><a class="button quiet" href="<%= ui.h(ui.path("/")) %>">Reset</a>
  </form><p class="filter-hint">Showing up to <%= limit %> most recent matching runs. Filter choices include the latest 1,000 runs.</p>
</section>
<% if runs.empty? %>
<section class="panel empty-state"><div class="empty-icon" aria-hidden="true">↗</div><h2>No evaluation runs yet</h2><p><%= query.values.any? { |value| !value.empty? } ? "No runs match these filters. Reset the filters to explore your history." : "Run an evaluation suite and save its results to begin building your quality history." %></p><% if query.values.any? { |value| !value.empty? } %><a class="button primary" href="<%= ui.h(ui.path("/")) %>">Show all runs</a><% else %><pre class="command">ruby_llm-evaluations run path/to/suite.rb</pre><% end %></section>
<% else %>
<% total_cases = runs.sum { |run| run["summary"]["cases"] }; total_passed = runs.sum { |run| run["summary"]["passed"] }; regression_count = comparisons.values.compact.count { |comparison| comparison["regressed"] }; latest = runs.first %>
<section class="stats-grid" aria-label="History summary">
  <article class="stat-card"><span class="stat-label">Recorded runs</span><strong><%= runs.length %></strong><span class="stat-caption">in this history view</span></article>
  <article class="stat-card"><span class="stat-label">Case pass rate</span><strong><%= ui.percent(total_cases.zero? ? 0 : total_passed.to_f / total_cases) %></strong><span class="stat-caption"><%= total_passed %> of <%= total_cases %> cases passed</span></article>
  <article class="stat-card"><span class="stat-label">Latest quality score</span><strong><%= ui.score(latest["summary"]["score"]) %></strong><span class="stat-caption"><%= ui.h(latest["suite"]) %> · <%= ui.h(latest["agent"]) %></span></article>
  <article class="stat-card"><span class="stat-label">Regressed runs</span><strong class="<%= regression_count.positive? ? "danger-text" : "teal-text" %>"><%= regression_count %></strong><span class="stat-caption">against prior matching baselines</span></article>
</section>
<% chart = ui.trend(runs) %>
<section class="panel chart-panel" aria-labelledby="trend-heading"><div class="section-heading"><div><p class="eyebrow">Quality over time</p><h2 id="trend-heading">Every run tells a story.</h2></div><span class="tag">Score · 0 to 1</span></div>
  <p class="section-description">Each line connects the same suite, agent, and dataset version. Points follow run chronology; select a point to inspect its evidence.</p>
  <svg class="trend-chart" viewBox="0 0 960 270" role="group" aria-labelledby="trend-title trend-desc"><title id="trend-title">Evaluation quality scores across <%= runs.length %> runs</title><desc id="trend-desc">Oldest run at left, newest at right. Separate lines indicate distinct suite, agent, and dataset combinations. The run history table provides the same scores as text.</desc>
    <% [1.0, 0.75, 0.5, 0.25, 0.0].each do |tick| %><line class="grid-line" x1="62" x2="912" y1="<%= 218 - tick * 176 %>" y2="<%= 218 - tick * 176 %>"/><text class="axis-label" x="12" y="<%= 223 - tick * 176 %>"><%= format("%.2f", tick) %></text><% end %>
    <% chart[:series].each do |series| %><polyline fill="none" stroke="<%= series[:color] %>" stroke-width="2.5" points="<%= series[:points].map { |point| "#{point[:x]},#{point[:y]}" }.join(" ") %>"/><% series[:points].each do |point| %><a href="<%= ui.h(ui.run_path(point[:run]["id"])) %>" aria-label="<%= ui.h("#{series[:label]}, score #{ui.score(point[:run]["summary"]["score"])}, #{ui.time(point[:run]["started_at"])}") %>"><circle class="chart-point" cx="<%= point[:x] %>" cy="<%= point[:y] %>" r="5" fill="<%= series[:color] %>"><title><%= ui.h("#{point[:run]["suite"]} · #{point[:run]["agent"]}: #{ui.score(point[:run]["summary"]["score"])} — #{ui.time(point[:run]["started_at"])}") %></title></circle></a><% end %><% end %>
    <text class="axis-label" x="62" y="253"><%= ui.h(ui.time(chart[:first]["started_at"])) %></text><text class="axis-label" x="912" y="253" text-anchor="end"><%= ui.h(ui.time(chart[:last]["started_at"])) %></text>
  </svg>
  <ul class="chart-legend" aria-label="Chart series"><% chart[:series].each do |series| %><li><svg width="14" height="14" aria-hidden="true"><circle cx="7" cy="7" r="5" fill="<%= series[:color] %>"/></svg><%= ui.h(series[:label]) %></li><% end %></ul>
</section>
<section class="panel history-panel" aria-labelledby="history-heading"><div class="section-heading"><div><p class="eyebrow">The evidence</p><h2 id="history-heading">Run history</h2></div><span class="muted"><%= runs.length %> runs</span></div>
<div class="table-scroll"><table class="history-table"><caption class="sr-only">Evaluation runs, newest first, with quality and changes from previous matching runs</caption><thead><tr><th scope="col">Suite / agent</th><th scope="col">Started</th><th scope="col">Quality</th><th scope="col">Cases</th><th scope="col">Change</th><th scope="col">Duration</th><th scope="col"><span class="sr-only">Details</span></th></tr></thead><tbody>
<% runs.each do |run|; summary = run["summary"]; comparison = comparisons[run["id"]] %><tr><td><a class="suite-link" href="<%= ui.h(ui.run_path(run["id"])) %>"><%= ui.h(run["suite"]) %></a><span class="table-secondary"><%= ui.h(run["agent"]) %></span></td><td><time datetime="<%= ui.h(run["started_at"]) %>"><%= ui.h(ui.time(run["started_at"])) %></time><span class="table-secondary mono"><%= ui.h(run["id"][0, 8]) %> · <%= ui.h(run["suite_digest"][0, 8]) %></span></td><td><strong class="quality-score"><%= ui.score(summary["score"]) %></strong><span class="table-secondary"><%= ui.percent(summary["pass_rate"]) %> passed</span></td><td><%= summary["passed"] %> / <%= summary["cases"] %><% if summary["errors"].positive? %><span class="table-secondary danger-text"><%= summary["errors"] %> errors</span><% end %></td><td><% if comparison %><span class="badge <%= comparison["regressed"] ? "failed" : comparison["improvements"].empty? ? "neutral" : "passed" %>"><%= comparison["regressed"] ? "Regressed" : comparison["improvements"].empty? ? "Stable" : "Improved" %></span><span class="table-secondary"><%= ui.delta(comparison["score_delta"]) %> score</span><% else %><span class="badge neutral">First baseline</span><% end %></td><td><%= ui.duration(summary["duration_ms"]) %></td><td><a class="detail-link" href="<%= ui.h(ui.run_path(run["id"])) %>" aria-label="<%= ui.h("View #{run["suite"]} run #{run["id"]}") %>">View <span aria-hidden="true">↗</span></a></td></tr><% end %>
</tbody></table></div></section>
<% end %>
